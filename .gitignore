# CREDENTIALS & SECRETS (never track)
# NOTE: .gitignore does NOT support inline comments — keep comments on their own lines.
.env
.env.local
credentials.json
token.json
token_gmail.json
token_gmail_labels.json
token_sheets.json
token_sheets_broad.json
.mcp.json
# Service account JSON files (Google Cloud, etc.) — hyphenated key files
*-*.json
# OAuth tokens / service-account keys anywhere under tools/ and .claude/config/
tools/*.json
.claude/config/*.json
.claude/config/*token*
*service-account*.json
*serviceaccount*.json

# COMPILED & CACHE (never track)
__pycache__/
*.pyc
*.pyo
*.egg-info/

# TEMPORARY & LOGS (never track)
Temp/
*.bak
*.log
logs/

# CANDIDATE DATA & DERIVED FILES (sensitive, never track)
output/
data/

# SPECIFIC TEMPORARY FILES (not blanket rules)
job36_rejection_replies.json
job36_case_study_gmail_check.json
job32_invite_check.txt
job36_invite_check.txt
nain_tara_cv.pdf
