# Copy this file to .env and fill in your actual values
# NEVER commit .env to git — it contains secrets

# Email Configuration (choose one method)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=ayesha.khan@taleemabad.com
EMAIL_PASSWORD=your_app_password_here

# Recipient Emails
HR_EMAIL=hr@taleemabad.com
DEFAULT_CC=talent@taleemabad.com

# Optional: SendGrid (if using SendGrid instead of SMTP)
# SENDGRID_API_KEY=your_sendgrid_api_key_here

# =============================================================================
# WEBAPP (FastAPI backend) — added for the candidate-communication web app
# =============================================================================

# Runtime: development | production
APP_ENV=development

# Neon Postgres — use the POOLED (-pooler) connection string. ROTATE before deploy.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Anthropic (Claude API) for AI drafting
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-4-8

# Google Workspace SSO (passwordless; restricted to ALLOWED_DOMAIN)
GOOGLE_OAUTH_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your_client_secret
OAUTH_REDIRECT_URI=http://localhost:8000/auth/google/callback
ALLOWED_DOMAIN=taleemabad.com

# Session cookie signing secret (generate a long random string)
SESSION_SECRET=change-me-to-a-long-random-string

# Frontend origin (CORS + post-login redirect)
FRONTEND_ORIGIN=http://localhost:5173

# Outbound email (shared sender identity)
EMAIL_SENDER=hiring@taleemabad.com
# EMAIL_PASSWORD is shared with the existing EMAIL_PASSWORD above (Gmail app password)
